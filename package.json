{
  "name": "outlevo",
  "version": "0.2.0",
  "description": "Give it your website, get your sales pack: who to sell to, companies that fit, and emails built on quotes from their own sites. Open-source alternative to 11x, Artisan and Apollo's outreach.",
  "keywords": [
    "ai-sdr",
    "cold-email",
    "outbound",
    "lead-generation",
    "sales-automation",
    "b2b",
    "linkedin",
    "anthropic",
    "cli",
    "open-source"
  ],
  "homepage": "https://outlevo.com/?utm_source=community&utm_medium=npm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Outlevo/outlevo-community.git"
  },
  "bugs": {
    "url": "https://github.com/Outlevo/outlevo-community/issues"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "outlevo": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepack": "npm run build",
    "dev": "node --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
